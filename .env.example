# Application
APP_NAME=instagpt-graphrag
APP_ENV=development
LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536
OPENAI_CHAT_MODEL=gpt-4o-mini

# OpenRouter (fallback)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_CHAT_MODEL=anthropic/claude-3-haiku
OPENROUTER_FALLBACK_ENABLED=True

# NVIDIA API
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-ultra

# Google API (Gemini)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CHAT_MODEL=gemini-1.5-flash

# Ollama (Local LLM - no API key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.1

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_graph

# Web Search
SEARCH_PROVIDER=duckduckgo  # duckduckgo, google, bing
SEARCH_MAX_RESULTS=10
SEARCH_TIMEOUT=30

# Pipeline
MAX_CONCURRENT_URLS=3
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100
EMBEDDING_BATCH_SIZE=100

# Categorization
SIMILARITY_THRESHOLD=0.75
RERANK_TOP_K=20
FINAL_TOP_K=5

# Output
OUTPUT_DIR=./outputs
GRAPH_EXPORT_FORMAT=graphml  # graphml, gexf, json

# Playwright
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true

# Select primary provider and fallback chain for LLMs
# Options: openai, openrouter, nvidia, google, ollama
LLM_PROVIDER=ollama
LLM_FALLBACK_CHAIN=openai,openrouter,nvidia,google

# Instagram Access Token
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
