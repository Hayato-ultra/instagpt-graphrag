# Application
APP_NAME=instagpt-graphrag
APP_ENV=development
LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536
OPENAI_CHAT_MODEL=gpt-4o-mini

# OpenRouter (fallback)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_CHAT_MODEL=anthropic/claude-3-haiku

# NVIDIA API
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-ultra

# Google API (Gemini)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CHAT_MODEL=gemini-1.5-flash

# Ollama (Local LLM - no API key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.1

# Colab (Remote LLM via Google Colab + vLLM)
COLAB_BASE_URL=
COLAB_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
COLAB_API_KEY=not-needed

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/instagpt_graphrag

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_graph

# Neo4j Graph DB
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Web Search
SEARCH_PROVIDER=duckduckgo
SEARCH_MAX_RESULTS=10
SEARCH_TIMEOUT=30

# Pipeline
MAX_CONCURRENT_URLS=3
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=100
EMBEDDING_BATCH_SIZE=100

# Categorization
SIMILARITY_THRESHOLD=0.75
RERANK_TOP_K=20
FINAL_TOP_K=5

# Output
OUTPUT_DIR=./outputs
GRAPH_EXPORT_FORMAT=graphml

# Playwright
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true

# LLM Provider Selection
# Options: openai, openrouter, nvidia, google, ollama, colab
LLM_PROVIDER=openai
LLM_FALLBACK_CHAIN=openrouter,nvidia,google

# Instagram (optional - for Reel extraction)
INSTAGRAM_ACCESS_TOKEN=
